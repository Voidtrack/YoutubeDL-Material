{
  "name": "youtube-dl-material",
  "version": "4.3.2",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "codespaces": "ng serve --configuration=codespaces",
    "build": "ng build --configuration production",
    "prebuild": "node src/postbuild.mjs",
    "heroku-postbuild": "npm install --prefix backend",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "electron": "ng build --base-href ./ && electron .",
    "generate": "openapi --input ./\"Public API v1.yaml\" --output ./src/api-types --exportCore false --exportServices false --exportModels true",
    "i18n-source": "ng extract-i18n --output-path=src/assets/i18n --out-file=messages.en.xlf"
  },
  "engines": {
    "node": ">20.11.1",
    "npm": ">11.0"
  },
  "private": true,
  "dependencies": {
    "@angular-devkit/core": "^20.2.1",
    "@angular/animations": "^20.2.3",
    "@angular/cdk": "^20.2.1",
    "@angular/common": "^20.2.3",
    "@angular/compiler": "^20.2.3",
    "@angular/core": "^20.2.3",
    "@angular/forms": "^20.2.3",
    "@angular/localize": "^20.2.3",
    "@angular/material": "^20.2.1",
    "@angular/platform-browser": "^20.2.3",
    "@angular/platform-browser-dynamic": "^20.2.3",
    "@angular/router": "^20.2.3",
    "@fontsource/material-icons": "^5.2.5",
    "@ngneat/content-loader": "^7.0.0",
    "@videogular/ngx-videogular": "^20.0.0",
    "core-js": "^3.45.1",
    "crypto-js": "^4.2.0",
    "file-saver-es": "^2.0.5",
    "filesize": "^11.0.2",
    "fs-extra": "^11.3.1",
    "material-icons": "^1.13.14",
    "nan": "^2.23.0",
    "ngx-avatars": "^1.10.0",
    "ngx-file-drop": "^16.0.0",
    "rxjs": "^7.8.2",
    "rxjs-compat": "^6.6.7",
    "tslib": "^2.8.1",
    "typescript": "^5.9.2",
    "xliff-to-json": "^1.1.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.2.1",
    "@angular/cli": "^20.2.1",
    "@angular/compiler-cli": "^20.2.3",
